# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Port where Express server listens (default 3000)
PORT="3000"

# JWT_SECRET: Secret key for signing JSON Web Tokens
JWT_SECRET="super_secret_jwt_key_hospital_patient_queue_2026"

# MONGODB_URI: Optional connection string for external MongoDB cluster
# (If not provided, the application automatically uses the built-in MERN in-memory store)
MONGODB_URI="mongodb://localhost:27017/hospital_queue"

# ADMIN_EMAIL: Optional custom administrator email (defaults to admin@hospital.com)
ADMIN_EMAIL="admin@hospital.com"

# ADMIN_PASSWORD: Optional administrator password configured at launch or reset locally
ADMIN_PASSWORD=""
